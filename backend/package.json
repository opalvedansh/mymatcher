{
  "name": "matcherc-backend",
  "version": "1.0.0",
  "description": "REST API backend for the Matcherc brand-influencer matching platform",
  "main": "src/app.js",
  "scripts": {
    "start": "node migrate.js && node src/app.js",
    "predev": "sh scripts/predev.sh",
    "dev": "nodemon src/app.js",
    "chat": "node src/chatServer.js",
    "worker": "node src/worker.js",
    "migrate": "node migrate.js",
    "test": "jest --forceExit --detectOpenHandles --verbose",
    "test:integration": "node tests/integration/controllers.js && node tests/integration/migrate.mjs && node tests/integration/scale.js"
  },
  "redisMemoryServer": {
    "disablePostinstall": "1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "moduleNameMapper": {
      "expo-server-sdk": "<rootDir>/tests/__mocks__/expo-server-sdk.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1111.0",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@supabase/supabase-js": "^2.112.0",
    "apify-client": "^2.25.0",
    "bad-words": "^4.1.5",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.8",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^7.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mixpanel": "^0.23.0",
    "morgan": "^1.10.0",
    "opossum": "^10.0.0",
    "pg": "^8.11.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.1",
    "shrink-ray-current": "^4.1.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.3",
    "redis-memory-server": "^0.17.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
