# Environment variables — copy to .env and fill in real values

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/matcherc

# Supabase — REQUIRED. The server refuses to start without these.
# Must point at the same project the mobile app uses.
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Auth JWT Secret — LEGACY, optional.
# Only needed for projects still issuing symmetric HS256 tokens. Projects using
# JWT signing keys issue ES256/RS256 tokens that are verified against
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json instead, and ignore this value.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Bcrypt rounds (10–12 recommended for production)
BCRYPT_ROUNDS=10

# AWS Configuration (For Rekognition Face Verification)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
