# The build context is now the repo root, which contains the Expo app, its
# node_modules and three xcodebuild logs totalling ~30MB. None of it belongs in
# the API image.
**/node_modules
**/dist
**/.git
**/.expo
**/.gstack
**/.claude

# Expo / React Native app
app/
src/
assets/
ios/
android/
App.tsx.backup
*.log
xcodebuild*.log
update_*.py
generate_routes.js
test-upload.js
pnpm-lock.yaml
package-lock.json
package.json
app.json
eas.json
codemagic.yaml
tsconfig.json

# Never bake secrets into the image; Railway injects them as env vars.
**/.env
**/.env.*
!**/.env.example
