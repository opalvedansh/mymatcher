{
  "name": "matcherc.app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@supabase/supabase-js": "^2.39.3",
    "expo": "^57.0.7",
    "expo-auth-session": "~57.0.9",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-image-picker": "^57.0.2",
    "expo-linear-gradient": "^57.0.0",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "concurrently \"expo start\" \"npm run dev --prefix backend\"",
    "admin": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix admin\"",
    "admin:install": "npm install --prefix admin",
    "admin:build": "npm run build --prefix admin && rm -rf backend/public/admin && mkdir -p backend/public && cp -r admin/dist backend/public/admin",
    "admin:serve": "npm run admin:build && npm run dev --prefix backend",
    "migrate": "node backend/migrate.js",
    "android": "concurrently \"expo start --android\" \"npm run dev --prefix backend\"",
    "ios": "concurrently \"expo start --ios\" \"npm run dev --prefix backend\"",
    "web": "concurrently \"expo start --web\" \"npm run dev --prefix backend\"",
    "update:prod": "eas update --branch production --message",
    "update:preview": "eas update --branch preview --message"
  },
  "private": true
}
