{
  "expo": {
    "name": "Matchr",
    "slug": "matchr",
    "version": "1.0.0",
    "scheme": "matchr",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.webnexis.mymatcher1",
      "buildNumber": "30",
      "associatedDomains": [
        "applinks:api.mymatchr.in"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Matchr uses the camera to take profile photos and photos or videos you send in chats.",
        "NSPhotoLibraryUsageDescription": "Matchr uses your photo library to upload profile photos and to send photos and videos in chats.",
        "NSMicrophoneUsageDescription": "Matchr uses the microphone to record voice messages and videos you send in chats."
      }
    },
    "android": {
      "package": "com.webnexis.matchr",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.mymatchr.in",
              "pathPrefix": "/p/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/30dd21ae-c95f-4436-9c2d-58ab7857bb7d"
    },
    "extra": {
      "eas": {
        "projectId": "8cad3c23-1b16-471b-abc3-5e9ca09b0941"
      },
      "router": {}
    },
    "owner": "vedansh_2111",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.943950919478-qdt1laap0hufg4f5cdh5vhkv7b75f48h"
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Matchr uses the microphone to record voice messages and videos you send in chats."
        }
      ],
      "expo-video"
    ]
  }
}
